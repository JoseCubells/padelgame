<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the engine-free EditMode test sources with NUnit 3 outside Unity.
       Tests must stay within the classic NUnit 3 API that Unity Test Framework ships. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(TestsRoot)**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Padel.Core/Padel.Core.csproj" />
    <ProjectReference Include="../Padel.Rules/Padel.Rules.csproj" />
    <ProjectReference Include="../Padel.Simulation/Padel.Simulation.csproj" />
    <ProjectReference Include="../Padel.AI/Padel.AI.csproj" />
  </ItemGroup>
</Project>
